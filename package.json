{
  "name": "nestjs-colyseus",
  "version": "0.2.0",
  "description": "Production-ready Colyseus integration for NestJS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/singoesdeep/nestjs-colyseus.git"
  },
  "homepage": "https://github.com/singoesdeep/nestjs-colyseus#readme",
  "bugs": {
    "url": "https://github.com/singoesdeep/nestjs-colyseus/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/esm/index.mjs"
    }
  },
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && node scripts/create-esm-wrapper.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config test/jest.config.cjs --runInBand",
    "test:watch": "jest --config test/jest.config.cjs --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "pack:check": "npm run build && npm pack --dry-run",
    "package:consumer": "node scripts/package-consumer.mjs"
  },
  "peerDependencies": {
    "@colyseus/core": ">=0.16 <0.17",
    "@colyseus/ws-transport": ">=0.16 <0.17",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0"
  },
  "devDependencies": {
    "@colyseus/core": "^0.16.0",
    "@colyseus/redis-driver": "^0.16.1",
    "@colyseus/redis-presence": "^0.16.4",
    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "^0.16.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.1.28",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "colyseus.js": "^0.16.22",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.0"
  }
}
